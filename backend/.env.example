# Supabase — get from https://supabase.com/dashboard/project/xtjzxynspkdhaeljnimp/settings/api
SUPABASE_URL=https://xtjzxynspkdhaeljnimp.supabase.co
SUPABASE_SERVICE_KEY=          # Settings > API > service_role (secret key, NOT anon)

# JWT — MUST be the Supabase JWT Secret
# Get from: Settings > API > JWT Settings > JWT Secret
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

# SendGrid — https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.xxxx

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxx

# Your Vercel frontend URL (no trailing slash)
FRONTEND_URL=https://your-app.vercel.app

# Your Vercel deployment URL (same as FRONTEND_URL for single-Vercel setup)
BACKEND_URL=https://your-app.vercel.app

# Any strong random string — used as X-Admin-Secret header for /analytics/* endpoints
ADMIN_SECRET=change-me-to-something-strong

# Telnyx SMS — https://portal.telnyx.com (API Keys, Numbers, Messaging profiles)
TELNYX_API_KEY=KEYxxxx
TELNYX_FROM_NUMBER=+1XXXXXXXXXX
TELNYX_MESSAGING_PROFILE_ID=

# --- Hardening switches (leave unset/false in production) ---
# ALLOW_LOCALHOST_CORS=true   # local dev only: allow any http://localhost:<port> origin
# ENABLE_API_DOCS=true        # local dev only: expose /docs
# SMS_ALLOWED_PREFIXES=+1     # comma-separated country prefixes SMS may be sent to
# ADMIN_SECRET must be a long random string (>= 32 chars); the admin API is disabled if empty.
