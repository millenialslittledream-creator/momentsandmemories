# Supabase — get from https://supabase.com/dashboard/project/xtjzxynspkdhaeljnimp/settings/api
SUPABASE_URL=https://xtjzxynspkdhaeljnimp.supabase.co
SUPABASE_SERVICE_KEY=          # Settings > API > service_role (secret key, NOT anon)

# JWT — MUST be the Supabase JWT Secret
# Get from: Settings > API > JWT Settings > JWT Secret
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

# SendGrid — https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=SG.xxxx

# Twilio — https://console.twilio.com
TWILIO_ACCOUNT_SID=ACxxxx
TWILIO_AUTH_TOKEN=xxxx
TWILIO_FROM_NUMBER=+1xxxxxxxxxx

# Google OAuth — https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxx

# Your Vercel frontend URL (no trailing slash)
FRONTEND_URL=https://your-app.vercel.app

# Any strong random string — used as X-Admin-Secret header for /analytics/* endpoints
ADMIN_SECRET=change-me-to-something-strong
