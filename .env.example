# Supabase Configuration
# Get these from your Supabase project dashboard: https://supabase.com/dashboard
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Optional override for the public template-artwork bucket. Production defaults
# to <VITE_SUPABASE_URL>/storage/v1/object/public/template-assets.
VITE_TEMPLATE_ASSET_BASE_URL=

# Google OAuth Client ID (public; same one configured in Supabase > Auth > Google).
# Enables Google's own sign-in popup so users never see the Supabase project domain.
# Also add your site origins under Google Cloud > Credentials > Authorized JavaScript origins.
VITE_GOOGLE_CLIENT_ID=
